from __future__ import annotations

from collections import defaultdict
from dataclasses import dataclass
from math import inf
from statistics import mean
from typing import Any, Iterable


@dataclass
class PerformanceSummary:
    total_trades: int
    winning_trades: int
    losing_trades: int
    breakeven_trades: int
    win_rate: float
    gross_profit: float
    gross_loss: float
    net_pnl: float
    average_pnl: float
    average_win: float
    average_loss: float
    profit_factor: float
    expectancy: float
    average_duration_minutes: float
    best_trade: float
    worst_trade: float

    def to_dict(self) -> dict[str, Any]:
        return {
            "total_trades": self.total_trades,
            "winning_trades": self.winning_trades,
            "losing_trades": self.losing_trades,
            "breakeven_trades": self.breakeven_trades,
            "win_rate": self.win_rate,
            "gross_profit": self.gross_profit,
            "gross_loss": self.gross_loss,
            "net_pnl": self.net_pnl,
            "average_pnl": self.average_pnl,
            "average_win": self.average_win,
            "average_loss": self.average_loss,
            "profit_factor": self.profit_factor,
            "expectancy": self.expectancy,
            "average_duration_minutes": self.average_duration_minutes,
            "best_trade": self.best_trade,
            "worst_trade": self.worst_trade,
        }


class PerformanceAnalyticsEngine:
    def summarize(
        self,
        trades: Iterable[dict[str, Any]],
    ) -> PerformanceSummary:
        closed = [
            dict(trade)
            for trade in trades
            if str(trade.get("status") or "").upper() == "CLOSED"
            and trade.get("pnl") is not None
        ]

        if not closed:
            return PerformanceSummary(
                total_trades=0,
                winning_trades=0,
                losing_trades=0,
                breakeven_trades=0,
                win_rate=0.0,
                gross_profit=0.0,
                gross_loss=0.0,
                net_pnl=0.0,
                average_pnl=0.0,
                average_win=0.0,
                average_loss=0.0,
                profit_factor=0.0,
                expectancy=0.0,
                average_duration_minutes=0.0,
                best_trade=0.0,
                worst_trade=0.0,
            )

        pnl_values = [float(trade["pnl"]) for trade in closed]
        winners = [value for value in pnl_values if value > 0]
        losers = [value for value in pnl_values if value < 0]
        breakeven = [value for value in pnl_values if value == 0]

        durations = [
            float(trade["duration_minutes"])
            for trade in closed
            if trade.get("duration_minutes") is not None
        ]

        total = len(closed)
        win_rate = (len(winners) / total) * 100.0
        gross_profit = sum(winners)
        gross_loss_abs = abs(sum(losers))
        profit_factor = (
            gross_profit / gross_loss_abs
            if gross_loss_abs > 0
            else (inf if gross_profit > 0 else 0.0)
        )

        average_win = mean(winners) if winners else 0.0
        average_loss = mean(losers) if losers else 0.0
        loss_rate = len(losers) / total
        win_rate_ratio = len(winners) / total
        expectancy = (
            win_rate_ratio * average_win
            + loss_rate * average_loss
        )

        return PerformanceSummary(
            total_trades=total,
            winning_trades=len(winners),
            losing_trades=len(losers),
            breakeven_trades=len(breakeven),
            win_rate=round(win_rate, 4),
            gross_profit=round(gross_profit, 8),
            gross_loss=round(gross_loss_abs, 8),
            net_pnl=round(sum(pnl_values), 8),
            average_pnl=round(mean(pnl_values), 8),
            average_win=round(average_win, 8),
            average_loss=round(average_loss, 8),
            profit_factor=round(profit_factor, 8) if profit_factor != inf else inf,
            expectancy=round(expectancy, 8),
            average_duration_minutes=round(mean(durations), 4) if durations else 0.0,
            best_trade=round(max(pnl_values), 8),
            worst_trade=round(min(pnl_values), 8),
        )

    def group_by(
        self,
        trades: Iterable[dict[str, Any]],
        field: str,
    ) -> dict[str, dict[str, Any]]:
        grouped: dict[str, list[dict[str, Any]]] = defaultdict(list)

        for trade in trades:
            key = trade.get(field)
            if key is None or key == "":
                key = "UNKNOWN"
            grouped[str(key)].append(dict(trade))

        return {
            key: self.summarize(items).to_dict()
            for key, items in sorted(grouped.items())
        }

    def ai_score_bands(
        self,
        trades: Iterable[dict[str, Any]],
    ) -> dict[str, dict[str, Any]]:
        grouped: dict[str, list[dict[str, Any]]] = defaultdict(list)

        for trade in trades:
            score = trade.get("ai_score")
            if score is None:
                label = "UNKNOWN"
            else:
                value = float(score)
                if value < 60:
                    label = "0-59"
                elif value < 70:
                    label = "60-69"
                elif value < 80:
                    label = "70-79"
                elif value < 90:
                    label = "80-89"
                else:
                    label = "90-100"
            grouped[label].append(dict(trade))

        order = ["0-59", "60-69", "70-79", "80-89", "90-100", "UNKNOWN"]
        result: dict[str, dict[str, Any]] = {}
        for label in order:
            if label in grouped:
                result[label] = self.summarize(grouped[label]).to_dict()
        return result

    def full_report(
        self,
        trades: Iterable[dict[str, Any]],
    ) -> dict[str, Any]:
        trade_list = [dict(trade) for trade in trades]
        return {
            "overall": self.summarize(trade_list).to_dict(),
            "by_market": self.group_by(trade_list, "market"),
            "by_market_regime": self.group_by(trade_list, "market_regime"),
            "by_ai_decision": self.group_by(trade_list, "ai_decision"),
            "by_sector": self.group_by(trade_list, "sector"),
            "by_ai_score_band": self.ai_score_bands(trade_list),
        }
