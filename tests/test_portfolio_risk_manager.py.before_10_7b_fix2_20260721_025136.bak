from __future__ import annotations

import pytest

from engine.portfolio_risk_manager import (
    PortfolioDecision,
    PortfolioRejectReason,
    PortfolioRequest,
    PortfolioRiskConfig,
    PortfolioRiskManager,
    PortfolioRuntimeBridge,
)


def request(
    symbol="BTCUSDT",
    side="BUY",
    price=100,
    quantity=100,
    stop_price=95,
    group="CRYPTO",
):
    return PortfolioRequest(
        symbol=symbol,
        side=side,
        price=price,
        quantity=quantity,
        stop_price=stop_price,
        group=group,
    )


def manager(**kwargs):
    config = {
        "initial_equity": 100_000,
        "max_open_positions": 5,
        "max_total_exposure_pct": 75,
        "max_symbol_exposure_pct": 25,
        "max_group_exposure_pct": 40,
        "max_total_risk_pct": 5,
        "max_risk_per_trade_pct": 1,
        "daily_loss_limit_pct": 3,
        "minimum_position_value": 100,
    }
    config.update(kwargs)
    return PortfolioRiskManager(PortfolioRiskConfig(**config))


def test_config_validation_equity() -> None:
    with pytest.raises(ValueError):
        PortfolioRiskConfig(initial_equity=0).validate()


def test_config_validation_positions() -> None:
    with pytest.raises(ValueError):
        PortfolioRiskConfig(max_open_positions=0).validate()


def test_config_validation_pct() -> None:
    with pytest.raises(ValueError):
        PortfolioRiskConfig(max_total_exposure_pct=101).validate()


def test_request_properties_long() -> None:
    item = request()
    assert item.signed_quantity == 100
    assert item.position_value == 10_000
    assert item.risk_amount == 500


def test_request_properties_short() -> None:
    item = request(side="SELL", stop_price=105)
    assert item.signed_quantity == -100
    assert item.risk_amount == 500


def test_approved_request() -> None:
    result = manager().evaluate(request())
    assert result.decision == PortfolioDecision.APPROVED
    assert result.approved is True


def test_invalid_side() -> None:
    result = manager().evaluate(request(side="X"))
    assert result.reason == PortfolioRejectReason.INVALID_REQUEST


def test_invalid_price() -> None:
    result = manager().evaluate(request(price=0))
    assert result.decision == PortfolioDecision.REJECTED


def test_minimum_value() -> None:
    result = manager().evaluate(request(price=1, quantity=10))
    assert result.reason == PortfolioRejectReason.INVALID_REQUEST


def test_symbol_limit_reduction() -> None:
    result = manager(
        max_symbol_exposure_pct=5
    ).evaluate(request(quantity=100))
    assert result.decision == PortfolioDecision.REDUCED
    assert result.approved_position_value == pytest.approx(5_000)


def test_symbol_limit_reject_when_reduction_disabled() -> None:
    result = manager(
        max_symbol_exposure_pct=5,
        allow_position_reduction=False,
    ).evaluate(request(quantity=100))
    assert result.decision == PortfolioDecision.REJECTED


def test_trade_risk_reduction() -> None:
    result = manager().evaluate(
        request(quantity=100, stop_price=80)
    )
    assert result.decision == PortfolioDecision.REDUCED
    assert result.risk_amount == pytest.approx(1_000)


def test_register_position() -> None:
    item = manager()
    req = request()
    evaluation = item.evaluate(req)
    pos = item.register_position(req, evaluation)
    assert pos.symbol == "BTCUSDT"
    assert item.metrics()["open_position_count"] == 1


def test_register_rejected_fails() -> None:
    item = manager()
    req = request(side="X")
    evaluation = item.evaluate(req)
    with pytest.raises(ValueError):
        item.register_position(req, evaluation)


def test_duplicate_symbol() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    result = item.evaluate(req)
    assert result.reason == PortfolioRejectReason.DUPLICATE_SYMBOL


def test_max_open_positions() -> None:
    item = manager(max_open_positions=1)
    first = request(symbol="BTCUSDT")
    item.register_position(first, item.evaluate(first))
    result = item.evaluate(request(symbol="ETHUSDT"))
    assert result.reason == PortfolioRejectReason.MAX_OPEN_POSITIONS


def test_group_exposure_reduction() -> None:
    item = manager(max_group_exposure_pct=15)
    first = request(symbol="BTCUSDT", quantity=100)
    item.register_position(first, item.evaluate(first))
    result = item.evaluate(request(symbol="ETHUSDT", quantity=100))
    assert result.decision == PortfolioDecision.REDUCED
    assert result.approved_position_value == pytest.approx(5_000)


def test_total_exposure_reduction() -> None:
    item = manager(
        max_total_exposure_pct=15,
        max_group_exposure_pct=100,
        max_symbol_exposure_pct=100,
    )
    first = request(symbol="BTCUSDT", quantity=100)
    item.register_position(first, item.evaluate(first))
    result = item.evaluate(request(symbol="ETHUSDT", quantity=100))
    assert result.reason == PortfolioRejectReason.TOTAL_EXPOSURE_LIMIT


def test_total_risk_reduction() -> None:
    item = manager(
        max_total_risk_pct=1.2,
        max_risk_per_trade_pct=1,
    )
    first = request(symbol="BTCUSDT", quantity=100, stop_price=95)
    item.register_position(first, item.evaluate(first))
    result = item.evaluate(
        request(symbol="ETHUSDT", quantity=100, stop_price=95)
    )
    assert result.decision == PortfolioDecision.REDUCED
    assert result.risk_amount == pytest.approx(700)


def test_daily_loss_limit() -> None:
    item = manager()
    item.record_realized_pnl(-3_000)
    result = item.evaluate(request())
    assert result.reason == PortfolioRejectReason.DAILY_LOSS_LIMIT


def test_reset_day() -> None:
    item = manager()
    item.record_realized_pnl(-2_000)
    item.reset_day()
    assert item.realized_pnl_today == 0
    assert item.daily_loss_pct == 0


def test_update_price() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    pos = item.update_price("BTC/USDT", 110)
    assert pos.current_price == 110
    assert pos.unrealized_pnl == 1_000


def test_update_missing_position() -> None:
    with pytest.raises(KeyError):
        manager().update_price("BTCUSDT", 100)


def test_close_long_position() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    pnl = item.close_position("BTCUSDT", 110)
    assert pnl == 1_000
    assert item.equity == 101_000


def test_close_short_position() -> None:
    item = manager()
    req = request(side="SELL", stop_price=105)
    item.register_position(req, item.evaluate(req))
    pnl = item.close_position("BTCUSDT", 90)
    assert pnl == 1_000


def test_total_exposure() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    assert item.total_exposure == 10_000


def test_total_risk() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    assert item.total_risk == 500


def test_group_exposure() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    assert item.group_exposure("crypto") == 10_000


def test_dashboard() -> None:
    item = manager()
    req = request()
    item.register_position(req, item.evaluate(req))
    data = item.dashboard()
    assert "metrics" in data
    assert len(data["positions"]) == 1


def test_history() -> None:
    item = manager()
    item.evaluate(request())
    assert len(item.history) == 1


def test_normalize_symbol() -> None:
    assert PortfolioRiskManager.normalize_symbol("btc-usdt") == "BTCUSDT"


def test_runtime_bridge() -> None:
    bridge = PortfolioRuntimeBridge(manager())
    result = bridge.evaluate_execution(
        symbol="BTCUSDT",
        side="BUY",
        price=100,
        quantity=100,
        stop_price=95,
        group="CRYPTO",
    )
    assert result.approved


def test_runtime_dashboard() -> None:
    bridge = PortfolioRuntimeBridge(manager())
    assert "metrics" in bridge.dashboard()
